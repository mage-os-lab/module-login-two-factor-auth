<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block name="mageos.customer.tfa.login"
                   template="MageOS_LoginTwoFactorAuth::login/verify.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\LoginTwoFactorAuth\ViewModel\Login</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
