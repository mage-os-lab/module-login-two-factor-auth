<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="customer-account-navigation-two-factor-link">
            <arguments>
                <argument name="current" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="mageos.customer.tfa.account"
                   template="MageOS_LoginTwoFactorAuth::account/manage.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\LoginTwoFactorAuth\ViewModel\Account</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
