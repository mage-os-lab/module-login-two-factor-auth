<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use MageOS\LoginTwoFactorAuth\ViewModel\Account;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var Account $viewModel */
$viewModel = $block->getData('view_model');
$state = $viewModel->getState();
$newCodes = $viewModel->getNewRecoveryCodes();
?>
<style>
    .mageos-tfa .tfa-badge { display: inline-flex; align-items: center; gap: .375rem; padding: .25rem .75rem; border-radius: 9999px; font-size: .875rem; font-weight: 600; }
    .mageos-tfa .tfa-badge--on { background: #dcfce7; color: #166534; }
    .mageos-tfa .tfa-badge--off { background: #f3f4f6; color: #4b5563; }
    .mageos-tfa .tfa-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .mageos-tfa .tfa-secret { user-select: all; overflow-wrap: anywhere; letter-spacing: .05em; }
    .mageos-tfa .tfa-qr { width: 200px; height: 200px; max-width: 100%; border: 1px solid #e5e7eb; border-radius: .5rem; }
    .mageos-tfa .tfa-codes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem 1.5rem; padding: 1rem; background: #f9fafb; border: 1px dashed #d1d5db; border-radius: .5rem; }
    .mageos-tfa .tfa-code-input { max-width: 12rem; letter-spacing: .3em; text-align: center; font-size: 1.125rem; }
    .mageos-tfa .tfa-section + .tfa-section { border-top: 1px solid #e5e7eb; margin-top: 1.5rem; padding-top: 1.5rem; }
</style>
<div class="mageos-tfa card">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <h2 class="text-xl font-semibold"><?= $escaper->escapeHtml(__('Two-Factor Authentication')) ?></h2>
        <?php if ($state === Account::STATE_ACTIVE): ?>
            <span class="tfa-badge tfa-badge--on"><?= $escaper->escapeHtml(__('Active')) ?></span>
        <?php else: ?>
            <span class="tfa-badge tfa-badge--off"><?= $escaper->escapeHtml(__('Not active')) ?></span>
        <?php endif; ?>
    </div>

    <?php if ($newCodes): ?>
        <div class="tfa-section" x-data="{ copied: false }">
            <h3 class="text-lg font-semibold mb-2"><?= $escaper->escapeHtml(__('Your recovery codes')) ?></h3>
            <p class="mb-4 text-sm">
                <?= $escaper->escapeHtml(__('Save these codes somewhere safe. Each one can be used once to sign in if you lose access to your authenticator app. They will not be shown again.')) ?>
            </p>
            <div class="tfa-codes tfa-mono mb-4" x-ref="codes">
                <?php foreach ($newCodes as $code): ?>
                    <span><?= $escaper->escapeHtml($code) ?></span>
                <?php endforeach; ?>
            </div>
            <div class="flex flex-wrap gap-4">
                <button type="button" class="btn btn-secondary"
                        @click="navigator.clipboard.writeText(<?= $escaper->escapeHtmlAttr(json_encode(implode("\n", $newCodes))) ?>).then(() => copied = true)">
                    <span x-show="!copied"><?= $escaper->escapeHtml(__('Copy codes')) ?></span>
                    <span x-show="copied" x-cloak><?= $escaper->escapeHtml(__('Copied!')) ?></span>
                </button>
                <a class="btn btn-secondary"
                   download="recovery-codes.txt"
                   href="data:text/plain;charset=utf-8,<?= $escaper->escapeHtmlAttr(rawurlencode(implode("\n", $newCodes) . "\n")) ?>">
                    <?= $escaper->escapeHtml(__('Download')) ?>
                </a>
            </div>
        </div>
    <?php endif; ?>

    <?php if ($state === Account::STATE_INACTIVE): ?>
        <div class="tfa-section">
            <p class="mb-4">
                <?= $escaper->escapeHtml(__('Add an extra layer of security to your account. When you sign in, besides your password you will be asked for a 6-digit code generated by an authenticator app on your phone (Google Authenticator, Microsoft Authenticator, Authy, 1Password…).')) ?>
            </p>
            <p class="mb-6 text-sm text-gray-600">
                <?= $escaper->escapeHtml(__('Two-factor authentication is optional: you can turn it off at any time.')) ?>
            </p>
            <form method="post" action="<?= $escaper->escapeUrl($viewModel->getActionUrl('setup')) ?>">
                <?= $block->getBlockHtml('formkey') ?>
                <button type="submit" class="btn btn-primary">
                    <?= $escaper->escapeHtml(__('Enable two-factor authentication')) ?>
                </button>
            </form>
        </div>
    <?php elseif ($state === Account::STATE_SETUP): ?>
        <div class="tfa-section">
            <h3 class="text-lg font-semibold mb-2"><?= $escaper->escapeHtml(__('1. Scan the QR code')) ?></h3>
            <p class="mb-4 text-sm">
                <?= $escaper->escapeHtml(__('Open your authenticator app and scan this code. On your phone you can tap the button to open the app directly.')) ?>
            </p>
            <div class="flex flex-col md:flex-row gap-6 items-start">
                <img class="tfa-qr shrink-0"
                     src="<?= $escaper->escapeHtmlAttr($viewModel->getQrCodeDataUri()) ?>"
                     alt="<?= $escaper->escapeHtmlAttr(__('QR code for your authenticator app')) ?>"
                     width="200" height="200">
                <div>
                    <p class="text-sm mb-2"><?= $escaper->escapeHtml(__('Can\'t scan it? Enter this key manually:')) ?></p>
                    <p class="tfa-mono tfa-secret text-lg mb-4"><?= $escaper->escapeHtml($viewModel->getFormattedSecret()) ?></p>
                    <a class="underline text-sm" href="<?= $escaper->escapeUrl($viewModel->getProvisioningUri()) ?>">
                        <?= $escaper->escapeHtml(__('Open in authenticator app')) ?>
                    </a>
                </div>
            </div>
        </div>
        <div class="tfa-section">
            <h3 class="text-lg font-semibold mb-2"><?= $escaper->escapeHtml(__('2. Enter the 6-digit code')) ?></h3>
            <form method="post" action="<?= $escaper->escapeUrl($viewModel->getActionUrl('activate')) ?>" class="mb-4">
                <?= $block->getBlockHtml('formkey') ?>
                <label class="label" for="tfa-activate-code"><?= $escaper->escapeHtml(__('Authentication code')) ?></label>
                <div class="flex flex-wrap gap-4 items-center">
                    <input id="tfa-activate-code" name="code" class="form-input tfa-code-input tfa-mono"
                           type="text" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7"
                           autocomplete="one-time-code" required autofocus placeholder="000000">
                    <button type="submit" class="btn btn-primary"><?= $escaper->escapeHtml(__('Activate')) ?></button>
                </div>
            </form>
            <form method="post" action="<?= $escaper->escapeUrl($viewModel->getActionUrl('cancel')) ?>">
                <?= $block->getBlockHtml('formkey') ?>
                <button type="submit" class="underline text-sm"><?= $escaper->escapeHtml(__('Cancel')) ?></button>
            </form>
        </div>
    <?php else: ?>
        <div class="tfa-section">
            <p class="mb-2">
                <?= $escaper->escapeHtml(__('Your account is protected: at every sign-in you will be asked for a code from your authenticator app.')) ?>
            </p>
            <p class="text-sm text-gray-600">
                <?php if ($activatedAt = $viewModel->getActivatedAt()): ?>
                    <?= $escaper->escapeHtml(__('Enabled on %1.', $activatedAt)) ?>
                <?php endif; ?>
                <?= $escaper->escapeHtml(__('Recovery codes left: %1.', $viewModel->getRemainingRecoveryCodes())) ?>
            </p>
        </div>

        <div class="tfa-section">
            <h3 class="text-lg font-semibold mb-2"><?= $escaper->escapeHtml(__('Recovery codes')) ?></h3>
            <p class="mb-4 text-sm"><?= $escaper->escapeHtml(__('Generate a new set of recovery codes. The current ones will stop working.')) ?></p>
            <form method="post" action="<?= $escaper->escapeUrl($viewModel->getActionUrl('regenerate')) ?>">
                <?= $block->getBlockHtml('formkey') ?>
                <label class="label" for="tfa-regenerate-code"><?= $escaper->escapeHtml(__('Authentication code')) ?></label>
                <div class="flex flex-wrap gap-4 items-center">
                    <input id="tfa-regenerate-code" name="code" class="form-input tfa-code-input tfa-mono"
                           type="text" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7"
                           autocomplete="one-time-code" required placeholder="000000">
                    <button type="submit" class="btn btn-secondary"><?= $escaper->escapeHtml(__('Generate new codes')) ?></button>
                </div>
            </form>
        </div>

        <div class="tfa-section" x-data="{ open: false }">
            <h3 class="text-lg font-semibold mb-2"><?= $escaper->escapeHtml(__('Turn off two-factor authentication')) ?></h3>
            <p class="mb-4 text-sm"><?= $escaper->escapeHtml(__('Your account will be protected by your password only.')) ?></p>
            <button type="button" class="btn btn-secondary" x-show="!open" @click="open = true">
                <?= $escaper->escapeHtml(__('Turn off')) ?>
            </button>
            <form method="post" action="<?= $escaper->escapeUrl($viewModel->getActionUrl('disable')) ?>"
                  x-show="open" x-cloak class="space-y-4">
                <?= $block->getBlockHtml('formkey') ?>
                <div>
                    <label class="label" for="tfa-disable-password"><?= $escaper->escapeHtml(__('Current password')) ?></label>
                    <input id="tfa-disable-password" name="password" type="password" class="form-input w-full"
                           style="max-width: 20rem" autocomplete="current-password" required>
                </div>
                <div>
                    <label class="label" for="tfa-disable-code"><?= $escaper->escapeHtml(__('Authentication code or recovery code')) ?></label>
                    <input id="tfa-disable-code" name="code" type="text" class="form-input tfa-mono"
                           style="max-width: 20rem" autocomplete="one-time-code" required>
                </div>
                <button type="submit" class="btn btn-primary"><?= $escaper->escapeHtml(__('Turn off two-factor authentication')) ?></button>
            </form>
        </div>
    <?php endif; ?>
</div>
